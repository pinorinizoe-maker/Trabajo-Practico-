/* ==========================================================================
   1. Reset & Variables CSS (Paleta Neón / Festival)
   ========================================================================== */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  /* Paleta de colores principal */
  --color-primario: #ffe600;   /* Amarillo neón */
  --color-secundario: #ff007a; /* Magenta neón */
  --color-acento: #00e5ff;     /* Cobre / Cyan neón */
  --color-verde: #00ff9d;      /* Verde neón */
  --color-fondo: #0b0b12;      /* Fondo oscuro */
  --color-card-bg: #161623;   /* Fondo tarjetas/tablas */
  --color-texto: #ffffff;      /* Texto principal */

  /* Tipografía base */
  --fuente-principal: 'Montserrat', system-ui, -apple-system, sans-serif;
  --radius-card: 16px;
  --transicion-rapida: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

html {
  scroll-behavior: smooth;
  color-scheme: dark;
}

body {
  font-family: var(--fuente-principal);
  background-color: var(--color-fondo);
  color: var(--color-texto);
  line-height: 1.6;
  font-size: 16px;
}

/* Scrollbar Personalizada */
::-webkit-scrollbar {
  width: 10px;
}
::-webkit-scrollbar-track {
  background: var(--color-fondo);
}
::-webkit-scrollbar-thumb {
  background: var(--color-secundario);
  border-radius: 5px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--color-primario);
}

/* ==========================================================================
   2. Estructura Principal & Centrado General
   ========================================================================== */
/* Centra todo el contenido en la pantalla con un ancho máximo adecuado */
main, header, footer {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* ==========================================================================
   3. Encabezado Fijo / Pegajoso & Navegación Horizontal
   ========================================================================== */
header {
  position: sticky;             /* Hace que se mantenga fijo al hacer scroll */
  top: 0;                       /* Se pega al borde superior de la ventana */
  z-index: 1000;                /* Asegura que quede por encima del resto del contenido */
  background-color: rgba(11, 11, 18, 0.95); /* Fondo oscuro semifluido */
  backdrop-filter: blur(10px);   /* Efecto vidriado/borroso de fondo */
  border-bottom: 2px solid var(--color-secundario);
  padding: 1rem 0;
  margin-bottom: 2rem;
  width: 100%;
  text-align: center;
}

header h1 {
  font-size: 2.2rem;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  color: var(--color-primario);
  text-shadow: 2px 2px 0px var(--color-secundario);
  margin-bottom: 0.3rem;
}

header p {
  color: var(--color-verde);
  font-weight: 700;
  font-size: 0.95rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 1.2rem;
}

/* Navegación horizontal con Flexbox */
nav ul {
  display: flex;             /* Muestra los enlaces en línea horizontal */
  justify-content: center;    /* Centra la lista horizontalmente */
  align-items: center;
  list-style: none;          /* Quita las viñetas */
  gap: 1.5rem;               /* Espaciado parejo entre enlaces */
  flex-wrap: wrap;           /* Se adapta en pantallas chicas */
  margin: 0 auto;
}

nav a {
  color: var(--color-texto);
  text-decoration: none;     /* Quita el subrayado por defecto */
  font-weight: 800;
  text-transform: uppercase;
  font-size: 0.9rem;
  letter-spacing: 1px;
  padding: 6px 14px;
  border-radius: 20px;
  transition: all var(--transicion-rapida);
}

/* Estado Hover y Página Activa */
nav a:hover,
nav a.activo {
  color: var(--color-fondo);
  background-color: var(--color-acento);
  box-shadow: 0 0 12px var(--color-acento);
}

/* ==========================================================================
   4. Secciones & Contenido General
   ========================================================================== */
section {
  margin-bottom: 3rem;
  text-align: center; /* Centra textos e imágenes por defecto */
}

h2 {
  font-size: clamp(1.8rem, 4vw, 2.5rem);
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  color: var(--color-acento);
  text-shadow: 3px 3px 0px var(--color-secundario);
  margin-bottom: 1.5rem;
}

h3 {
  color: var(--color-primario);
  font-size: 1.3rem;
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 0.8rem;
}

p {
  margin-bottom: 1rem;
  color: #d1d1e0;
}

/* Centrado de Imágenes */
img {
  max-width: 100%;
  height: auto;
  border-radius: var(--radius-card);
  border: 2px solid var(--color-primario);
  margin: 1rem auto;
  display: block;
}

/* Listas centradas/alineadas ordenadamente */
ul, ol {
  display: inline-block;
  text-align: left;
  margin: 1rem 0;
  padding-left: 1.5rem;
}

li {
  margin-bottom: 0.5rem;
}

/* ==========================================================================
   5. Tarjetas & Grillas Flexbox (Resumen / Datos)
   ========================================================================== */
.resumen-grid {
  display: flex;                /* Muestra los hijos en una fila horizontal */
  justify-content: space-between; /* Distribuye el espacio entre cada tarjeta */
  align-items: stretch;         /* Iguala la altura de todas las tarjetas */
  gap: 1.5rem;                  /* Espaciado parejo entre las tarjetas */
  flex-wrap: wrap;              /* Permite adaptarse en pantallas pequeñas */
  margin: 2rem 0;
}

.tarjeta-dato {
  flex: 1 1 250px;              /* Hace que sean responsivas (mínimo 250px) */
  background-color: var(--color-card-bg);
  padding: 1.5rem;
  border-radius: var(--radius-card);
  border: 2px solid var(--color-primario);
  box-shadow: 4px 4px 0px var(--color-secundario);
  text-align: center;
  transition: transform var(--transicion-rapida);
}

.tarjeta-dato:hover {
  transform: translateY(-5px);
  border-color: var(--color-acento);
}

.tarjeta-dato h3 {
  margin-bottom: 0.8rem;
  font-size: 1.1rem;
}

.tarjeta-dato p {
  margin-bottom: 0.4rem;
  font-size: 0.95rem;
}

/* ==========================================================================
   6. Tablas Estilizadas & Centradas
   ========================================================================== */
table {
  width: 100%;
  max-width: 900px;
  margin: 1.5rem auto;
  border-collapse: separate;
  border-spacing: 0;
  background-color: var(--color-card-bg);
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid var(--color-secundario);
}

th, td {
  padding: 12px 16px;
  text-align: center;
}

th {
  background-color: var(--color-secundario);
  color: #ffffff;
  font-weight: 800;
  text-transform: uppercase;
  font-size: 0.85rem;
  letter-spacing: 1px;
}

tr:nth-child(even) {
  background-color: rgba(255, 255, 255, 0.03);
}

td {
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

/* ==========================================================================
   7. Formulario de Contacto Centrado
   ========================================================================== */
form {
  max-width: 600px;
  margin: 2rem auto;
  background-color: var(--color-card-bg);
  padding: 2rem;
  border-radius: var(--radius-card);
  border: 2px solid var(--color-primario);
  box-shadow: 6px 6px 0px var(--color-secundario);
  text-align: left;
}

.grupo-input {
  margin-bottom: 1.2rem;
}

.grupo-input label {
  display: block;
  font-weight: 700;
  color: var(--color-verde);
  margin-bottom: 0.4rem;
  text-transform: uppercase;
  font-size: 0.85rem;
}

.grupo-input input,
.grupo-input select {
  width: 100%;
  padding: 12px;
  border-radius: 8px;
  border: 2px solid var(--color-acento);
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  outline: none;
  font-family: inherit;
}

.grupo-input input:focus,
.grupo-input select:focus {
  border-color: var(--color-primario);
  box-shadow: 0 0 10px rgba(255, 230, 0, 0.4);
}

.btn-enviar {
  display: block;
  width: 100%;
  background-color: var(--color-secundario);
  color: #ffffff;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  padding: 12px 28px;
  border: none;
  border-radius: 50px;
  cursor: pointer;
  box-shadow: 0 4px 15px rgba(255, 0, 122, 0.4);
  transition: transform var(--transicion-rapida), background-color var(--transicion-rapida);
}

.btn-enviar:hover {
  background-color: var(--color-acento);
  color: var(--color-fondo);
  box-shadow: 0 4px 20px rgba(0, 229, 255, 0.6);
}

/* ==========================================================================
   8. Pie de Página Centrado
   ========================================================================== */
footer {
  border-top: 2px solid var(--color-acento);
  padding: 2rem 0;
  text-align: center;
  font-size: 0.9rem;
  color: #a0a0b0;
  margin-top: 3rem;
}
/* ==========================================================================
   Bootstrap - Personalizaciones & Overrides (Estilo Neón)
   ========================================================================== */

/* Fondo del Header y borde magenta */
header.sticky-top {
  z-index: 1000;
}

.navbar {
  background-color: rgba(11, 11, 18, 0.95) !important;
  backdrop-filter: blur(10px);
  border-bottom: 2px solid var(--color-secundario);
  padding: 0.8rem 0;
}

/* Marca / Logo de la Ciudad */
.navbar-brand.logo {
  font-size: 1.5rem;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  color: var(--color-primario) !important;
  text-shadow: 2px 2px 0px var(--color-secundario);
  letter-spacing: -0.5px;
}

/* Enlaces de Navegación */
.navbar-nav .nav-link {
  color: var(--color-texto) !important;
  font-weight: 800;
  text-transform: uppercase;
  font-size: 0.85rem;
  letter-spacing: 1px;
  padding: 6px 14px !important;
  border-radius: 20px;
  transition: all var(--transicion-rapida);
}

/* Estado Hover y Enlace Activo (Cyan neón con brillo) */
.navbar-nav .nav-link:hover,
.navbar-nav .nav-link.activo {
  color: var(--color-fondo) !important;
  background-color: var(--color-acento);
  box-shadow: 0 0 12px var(--color-acento);
}

/* Botón Hamburguesa en Mobile */
.navbar-toggler {
  border: 2px solid var(--color-acento);
  padding: 4px 8px;
}

.navbar-toggler:focus {
  box-shadow: 0 0 10px var(--color-acento);
}

.navbar-toggler-icon {
  filter: invert(1); /* Mantiene visible el icono de líneas sobre fondo oscuro */
}
